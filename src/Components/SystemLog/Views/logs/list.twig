{% set dash_active = 'system_log' %}
{% extends '@dashboard/layouts/base.twig' %}

{% block title %}System log{% endblock %}
{% block content_title %}System log{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ uri('admin.dashboard') }}">Home</a></li>
    <li class="breadcrumb-item active" aria-current="page">System log</li>
{% endblock %}

{% block body %}
    <div class="row mb-3">
        <div class="col-12">
            {% if events is not empty %}
                <div class="btn-group flex-wrap" role="group" aria-label="Filter by event">
                    <a href="{{ uri('admin.system_log') }}" class="btn btn-sm {{ active_event is null ? 'btn-primary' : 'btn-outline-primary' }}">All</a>
                    {% for eventName in events %}
                        <a href="{{ uri('admin.system_log') ~ '?event=' ~ eventName|url_encode }}" class="btn btn-sm {{ active_event == eventName ? 'btn-primary' : 'btn-outline-primary' }}">{{ eventName }}</a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Audit events</h3>
            {% if logs.total > 0 %}
                <span class="badge text-bg-primary ms-2">{{ logs.total }} records</span>
            {% endif %}
        </div>
        <div class="card-body table-responsive p-0">
            <table class="table table-striped table-hover mb-0">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Event</th>
                    <th>Message</th>
                    <th>Actor</th>
                    <th>Subject</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for log in logs %}
                    <tr>
                        <td>#{{ log.id }}</td>
                        <td><span class="badge text-bg-secondary">{{ log.event }}</span></td>
                        <td class="text-break" style="max-width: 360px;">{{ log.message }}</td>
                        <td>{{ log.actor_user_id ? '#' ~ log.actor_user_id : '—' }}</td>
                        <td>
                            {% if log.subject_type and log.subject_id %}
                                {{ log.subject_type }} #{{ log.subject_id }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>{{ log.created_at ? log.created_at|date('Y-m-d H:i:s') : '—' }}</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" href="{{ uri('admin.system_log.show', {id: log.id}) }}">View</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">No log entries found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer clearfix">
            <span class="float-start text-muted">
                Showing <strong>{{ logs.firstItem }}&ndash;{{ logs.lastItem }}</strong> of {{ logs.total }}
            </span>
            {% include '@dashboard/partials/_pagination.twig' with {items: logs} %}
        </div>
    </div>
{% endblock %}
